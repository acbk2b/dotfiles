[push]
	autoSetupRemote = true
[remote "origin"]
	prune = true
[init]
	defaultBranch = main
[remote]
	origin = prune
[pull]
	rebase = false

[includeIf "gitdir:~/repos/personal/"]
	path = ~/.gitconfig.personal
[includeIf "gitdir:~/repos/work/"]
	path = ~/.gitconfig.work

[alias]
    # delta
    delta = -c core.pager=delta diff
