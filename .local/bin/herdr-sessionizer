#!/usr/bin/env bash
set -euo pipefail

# Herdr runs popup commands with the server's environment.
# On remote (SSH) machines, this is a minimal $PATH
export PATH="$HOME/.local/bin:$PATH"

project=$(
  find "$HOME/repos/personal" "$HOME/repos/work"  \
    -mindepth 1 -maxdepth 1 -type d 2>/dev/null |
    fzf --prompt="Project > " --preview="ls"
)

[[ -n "$project" ]] || exit 0

"${HERDR_BIN_PATH:-herdr}" workspace create \
  --cwd "$project" \
  --label "$(basename "$project")" \
  --focus
