#! /bin/bash

set -euo pipefail

# Bookmark directory containing bookmark files
BM_DIR="${BM_DIR:=$HOME/notes/areas/bookmarks}"

# Default to fzf for URL selection, optionally run as dmenu script with -d
picker=(fzf)
if [[ "${1:-}" == "-d" ]]; then
	picker=(rofi -dmenu)
fi

# Read bookmark files safely, select a line, then extract its whitespace-delimited URL.
sel=$(find "$BM_DIR" -type f ! -name '.*' -exec cat -- {} + |
	"${picker[@]}" |
	awk 'NF >= 2 { print $2 }') || exit $?

if [[ -n "$sel" ]]; then
	printf '%s' "$sel" | pbcopy
fi
