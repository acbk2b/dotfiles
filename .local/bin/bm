#! /bin/bash

set -euo pipefail

# Bookmark directory containing bookmark files
BM_DIR="${BM_DIR:=$HOME/notes/areas/bookmarks}"

# Default to fzf for URL selection, optionally run as dmenu script with -d
PROG="fzf"
if [[ "${1:-}" == "-d" ]]; then
	PROG="rofi -dmenu"
fi

# Get bookmarks files
bookmarks="$(find "$BM_DIR" -type f -not -name '.*' | xargs)"

# cat bookmarks full list + select + copy to clipboard (if selected)
sel=$(cat $bookmarks | $PROG | awk -F '"' '{print $2}') && echo "$sel" | pbcopy
