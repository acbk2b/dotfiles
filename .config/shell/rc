# vim: filetype=sh
# Unified shell rc, symlinked as ~/.bashrc and ~/.zshrc.
# Shell-agnostic config lives up top; per-dialect blocks are fenced by
# $ZSH_VERSION / $BASH_VERSION

# Launch tmux for non-ssh sessions
if command -v tmux &>/dev/null && [[ -z "$TMUX" ]] && [[ -z "$SSH_CLIENT" ]] && [[ -z "$SSH_TTY" ]]; then
	exec tmux new-session
fi

# History file sizing
HIST_SIZE=1000

# Load aliases
[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/shell/aliasrc" ] && source "${XDG_CONFIG_HOME:-$HOME/.config}/shell/aliasrc"

if [ -n "$ZSH_VERSION" ]; then
	# History
	HISTFILE="${XDG_CACHE_HOME:-$HOME/.cache}/.zsh_history"
	HISTSIZE=$HIST_SIZE
	SAVEHIST=$HIST_SIZE
	HISTDUP=erase
	setopt appendhistory
	setopt sharehistory
	setopt hist_ignore_space
	setopt hist_ignore_all_dups
	setopt hist_save_no_dups
	setopt hist_ignore_dups
	setopt hist_find_no_dups

	# Completions
	autoload -Uz compinit
	compinit
	# Fuzzy match completions for autocd and other commands
	zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
	# Disable default completion menu
	zstyle ':completion:*' menu no
	zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls $realpath'

	# Auto cd
	setopt autocd

	# Vi mode
	bindkey -v
	# Fix backspace in vi mode
	bindkey '^?' backward-delete-char

	# Prompt (with git branch via vcs_info)
	autoload -U colors && colors
	autoload -Uz vcs_info
	precmd() { vcs_info; }
	zstyle ':vcs_info:git:*' formats '%b'
	setopt prompt_subst
	PS1='%B%{$fg[red]%}[%{$fg[yellow]%}%n%{$fg[green]%}@%{$fg[blue]%}%M %{$fg[magenta]%}%~%{$fg[red]%}]$fg[green](${vcs_info_msg_0_})
$%{$reset_color%}%b '

	# Keybinds
	bindkey '^f' autosuggest-accept
	bindkey '^p' history-search-backward
	bindkey '^n' history-search-forward

	# fzf
	eval "$(fzf --zsh)"

elif [ -n "$BASH_VERSION" ]; then
	# History
	HISTFILE=~/.bash_history
	HISTSIZE=$HIST_SIZE
	HISTFILESIZE=$HIST_SIZE
	shopt -s histappend           # Append history instead of overwriting
	export HISTCONTROL=ignoreboth # Ignore duplicates and commands starting with spaces

	# Completions
	if [ -f /etc/bash_completion ]; then
		. /etc/bash_completion
	fi

	# Auto cd (cd without typing "cd")
	shopt -s autocd

	# Prompt (with git branch)
	PS1='\[\033[1;31m\][\[\033[1;33m\]\u\[\033[1;32m\]@\[\033[1;34m\]\h \[\033[1;35m\]\w\[\033[1;31m\]]\[\033[1;32m\]($(git branch 2>/dev/null | grep -e "^*" | sed "s/^* //"))\n$ \[\033[0m\]'

	# fzf
	[ -f ~/.fzf.bash ] && source ~/.fzf.bash
fi
