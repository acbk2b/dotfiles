# vim: filetype=sh
# Unified shell rc, symlinked as ~/.bashrc and ~/.zshrc.
# Shell-agnostic config lives up top; per-dialect blocks are fenced by
# $ZSH_VERSION / $BASH_VERSION

# Launch tmux for non-ssh sessions
if command -v tmux &>/dev/null && [[ -z "$TMUX" ]] && [[ -z "$SSH_CLIENT" ]] && [[ -z "$SSH_TTY" ]]; then
	exec tmux new-session
fi

# History file sizing
HIST_SIZE=1000

# Load aliases
[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/shell/aliasrc" ] && source "${XDG_CONFIG_HOME:-$HOME/.config}/shell/aliasrc"

if [ -n "$ZSH_VERSION" ]; then
	# Deduplicate paths accumulated by inherited environment and startup files.
	typeset -U path PATH fpath FPATH

	# History
	HISTFILE="${XDG_CACHE_HOME:-$HOME/.cache}/.zsh_history"
	HISTSIZE=$HIST_SIZE
	SAVEHIST=$HIST_SIZE
	HISTDUP=erase
	setopt appendhistory
	setopt sharehistory
	setopt hist_ignore_space
	setopt hist_ignore_all_dups
	setopt hist_save_no_dups
	setopt hist_ignore_dups
	setopt hist_find_no_dups

	# Completions: trust an existing dump to avoid a full audit on every shell.
	autoload -Uz compinit
	if [[ -s "${ZDOTDIR:-$HOME}/.zcompdump" ]]; then
		compinit -C
	else
		compinit
	fi
	# Fuzzy match completions for autocd and other commands
	zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
	# Disable default completion menu
	zstyle ':completion:*' menu no
	zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls $realpath'

	# Auto cd
	setopt autocd

	# Vi mode
	bindkey -v
	# Fix backspace in vi mode
	bindkey '^?' backward-delete-char

	# Prompt (with git branch). Refresh Git state before every prompt.
	autoload -U colors && colors
	typeset -g __prompt_vcs_branch=
	precmd() {
		__prompt_vcs_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || __prompt_vcs_branch=
	}
	setopt prompt_subst
	PS1='%B%{$fg[red]%}[%{$fg[yellow]%}%n%{$fg[green]%}@%{$fg[blue]%}%M %{$fg[magenta]%}%~%{$fg[red]%}]%{$fg[green]%}${__prompt_vcs_branch:+(${__prompt_vcs_branch})}
$%{$reset_color%}%b '

	# Keybinds
	bindkey '^f' autosuggest-accept
	bindkey '^p' history-search-backward
	bindkey '^n' history-search-forward

	# fzf
	eval "$(fzf --zsh)"

elif [ -n "$BASH_VERSION" ]; then
	# History
	HISTFILE=~/.bash_history
	HISTSIZE=$HIST_SIZE
	HISTFILESIZE=$HIST_SIZE
	shopt -s histappend           # Append history instead of overwriting
	export HISTCONTROL=ignoreboth # Ignore duplicates and commands starting with spaces

	# Completions
	if [ -f /etc/bash_completion ]; then
		. /etc/bash_completion
	fi

	# Auto cd (cd without typing "cd") when supported (Bash 4+).
	shopt -s autocd 2>/dev/null || true

	# Prompt (with git branch). Refresh Git state before every prompt.
	__prompt_vcs_branch=
	__prompt_update_vcs() {
		__prompt_vcs_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || __prompt_vcs_branch=
	}
	# Preserve any prompt hooks installed before this file (compatible with Bash 3.2).
	case ";${PROMPT_COMMAND:-};" in
		*";__prompt_update_vcs;"*) ;;
		*) PROMPT_COMMAND="__prompt_update_vcs${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
	esac
	PS1='\[\033[1;31m\][\[\033[1;33m\]\u\[\033[1;32m\]@\[\033[1;34m\]\h \[\033[1;35m\]\w\[\033[1;31m\]]\[\033[1;32m\]${__prompt_vcs_branch:+(${__prompt_vcs_branch})}\n$ \[\033[0m\]'

	# fzf
	[ -f ~/.fzf.bash ] && source ~/.fzf.bash
fi
