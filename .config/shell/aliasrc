          --skill codebase-design \
          --skill domain-modeling \
          --skill grill-me \
          --skill grill-with-docs \
          --skill grilling \
          --skill improve-codebase-architecture \
          --skill research \
          --skill tdd \
          --skill teach \
          --agent claude-code \
          --global \
          -y
    bunx skills add JuliusBrussee/caveman \
          --skill caveman \
