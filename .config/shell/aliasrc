# Shell functions

# fzf repo hopper
zr() {
	repos="$HOME/repos"
	local -a cmd

	# use fd if available, fallback to find if not
	if command -v "fd" >/dev/null 2>&1; then
		cmd=(fd -H -L -I -t d "^\.git$" "$repos")
	else
		cmd=(find -L "$repos" -type d -name .git)
	fi

	local dir
	dir=$("${cmd[@]}" 2>/dev/null | xargs dirname | fzf --preview 'ls {}') && cd "$dir"
}

vf() {
	local f
	f=$(fzf) && $EDITOR "$f"
}

skills() {
    # Install code claude explicitly (via symlink), `~/.agents/skills` is included by default
